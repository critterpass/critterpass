{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cp-media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // AsyncLocalStorage for @sentry/cloudflare request isolation.
  "compatibility_flags": ["nodejs_als"],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cp-media-dev" }],
  "env": {
    "staging": {
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cp-media-staging" }],
      "routes": [{ "pattern": "media.staging.critterpass.app", "custom_domain": true }],
    },
    "production": {
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cp-media-prod" }],
      // "routes": [{ "pattern": "media.critterpass.app/*", "custom_domain": true }]
    },
  },
}
