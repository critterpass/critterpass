{
  "name": "@cp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono API: auth, commands, sync upload, extension actions, AI stream, webhooks, links, realtime proxy",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@better-auth/expo": "1.7.6",
    "@cp/ai": "workspace:*",
    "@cp/db": "workspace:*",
    "@cp/domain": "workspace:*",
    "@cp/entitlements": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "0.12.6",
    "asn1js": "catalog:",
    "aws4fetch": "catalog:",
    "better-auth": "1.7.6",
    "cbor": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "libphonenumber-js": "1.13.14",
    "pg": "catalog:",
    "pino": "catalog:",
    "pkijs": "catalog:",
    "redis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@peculiar/x509": "2.1.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/pg": "catalog:",
    "reflect-metadata": "0.2.2",
    "testcontainers": "catalog:",
    "tsdown": "catalog:"
  }
}
