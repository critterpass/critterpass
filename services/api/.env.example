# api service (Railway variables in staging/production; values here are local compose defaults)
NODE_ENV=development
# local | staging | production
APP_ENV=local
PORT=8787
LOG_LEVEL=info
# Pooled connection (PgBouncer :6432 on PlanetScale); compose Postgres on host port 54320 locally
DATABASE_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
# Direct connection (:5432), used only by the pre-deploy migration step
DATABASE_DIRECT_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
REDIS_URL=redis://localhost:63790
PUBLIC_BASE_URL=http://localhost:8787
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
COMMIT_SHA=dev

# --- Auth (Better Auth), OTP, attestation (docs/data-model.md §2, §3.1) ---
# Better Auth's own connection, authenticated as the narrower `auth` role in staging/production
# (Railway variable, password set out-of-band per docs/system-architecture.md §6 — never in SQL).
# Locally app_owner already inherits the auth role, so it can stand in without extra setup.
AUTH_DATABASE_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
# 32+ chars; generate a real one with `openssl rand -base64 32`. Encrypts JWKS private keys at rest.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output-not-this
# Comma-separated extra origins/app schemes Better Auth accepts (mobile schemes are always included).
# Staging: the mobile Expo scheme(s) from apps/mobile/app.config.ts plus the web/admin staging
# origins (infra/cloudflare/, apps/web, apps/admin) — see this phase's build report for the exact list.
APP_TRUSTED_ORIGINS=

# --- Attestation (defaults to log-only: no Apple team id or verified device fixture yet) ---
ATTESTATION_MODE=log
APPLE_APP_ATTEST_TEAM_ID=
APPLE_APP_ATTEST_BUNDLE_ID=
# Public data (Apple's own App Attest root CA), not a secret; absent until verified and provisioned.
APPLE_APP_ATTEST_ROOT_CERT_PEM=
APPLE_APP_ATTEST_ALLOW_DEV_ENV=true

# --- Phone OTP sender router (each channel skipped when its own credentials are absent) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANGUAGE_CODE=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TWILIO_VERIFY_ACCOUNT_SID=
TWILIO_VERIFY_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PRELUDE_API_KEY=

# --- Social sign-in (Apple/Google ID-token linking; button hidden client-side when unset) ---
APPLE_SOCIAL_CLIENT_IDS=
APPLE_SOCIAL_APP_BUNDLE_ID=
GOOGLE_SOCIAL_CLIENT_IDS=

# --- Sign in with Apple authorization-code exchange (separate service-id credential) ---
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY_PEM=
APPLE_SIWA_REDIRECT_URI=

# --- Field-level encryption (packages/db/src/crypto); routes needing it are unregistered when unset ---
# keyId1:base64key1,keyId2:base64key2 — generate a value with `openssl rand -base64 32`.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
PHONE_HASH_PEPPER=
