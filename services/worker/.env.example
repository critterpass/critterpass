# worker service (Railway variables in staging/production; values here are local compose defaults)
NODE_ENV=development
PORT=8788
LOG_LEVEL=info
# Direct connection (:5432): LISTEN/NOTIFY and job locking need it
DATABASE_DIRECT_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
REDIS_URL=redis://localhost:63790
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
COMMIT_SHA=dev
