# worker service (Railway variables in staging/production; values here are local compose defaults)
NODE_ENV=development
# local | staging | production
APP_ENV=local
PORT=8788
LOG_LEVEL=info
# Direct connection (:5432): pg-boss and the LISTEN clients need it
DATABASE_DIRECT_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
# Pooled connection (PgBouncer :6432) for job handlers; empty = they use the direct connection
DATABASE_URL=
# Pool sizes (infra/railway/README.md, Database connection budget); empty = the defaults
DB_POOL_MAX=
JOBS_POOL_MAX=
REDIS_URL=redis://localhost:63790
SENTRY_DSN=
# PostHog EU (product analytics); unset = analytics off.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# HMAC key (16+ chars) for the pseudonymous analytics user_pid; same value in api and worker.
ANALYTICS_PID_SALT=
OTEL_EXPORTER_OTLP_ENDPOINT=
COMMIT_SHA=dev

# --- Places: POI ingest and live checks ---
# Foursquare Places API key (live open/closed checks, services/worker/src/places/live-check.ts).
# Live-check hours/closed_bucket are billed Pro fields; a 429 "no API credits" response is a
# documented account gate this project has not resolved yet (see ingest.ts's file header).
FOURSQUARE_API_KEY=
# Overrides the Overture release path read by services/worker/src/places/ingest.ts; optional, code
# defaults to the latest confirmed-available release at the time that file was written.
OVERTURE_RELEASE=
# A parquet export (local path or URI) standing in for FSQ OS Places' Iceberg catalog, which needs a
# Places Portal account this project does not have; ingest runs Overture-only when unset.
FSQ_OS_PLACES_PARQUET_URI=

# --- Realtime: rt_outbox relay to Centrifugo's server API (services/worker/src/rt-relay) ---
# Both unset = the relay does not run. Local compose Centrifugo serves its server API on the internal port :9000 with the key below.
CENTRIFUGO_API_URL=http://localhost:9000
CENTRIFUGO_HTTP_API_KEY=local-centrifugo-api-key

# --- Nightly database backup (ops.backup, services/worker/src/jobs/ops/backup.ts) ---
# Staging/production must set all of these (the job dead-letters and alerts otherwise); local runs
# no backup unless they are set. The dump role needs BYPASSRLS and read access to every schema.
BACKUP_DATABASE_URL=
# Off-provider S3-compatible bucket (Cloudflare R2): https://<account>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# pg_dump 18 or newer (the worker image installs it; Homebrew: /opt/homebrew/opt/postgresql@18/bin/pg_dump)
BACKUP_PG_DUMP_PATH=pg_dump
# --- Avatar moderation and variants (services/worker/src/jobs/avatar) ---
# The media bucket, same values as the api's R2_*; unset = photo avatars wait for ops review and no
# PNG variants are rendered.
R2_S3_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# PhotoDNA Cloud Service key for known-image hash matching (used once ops switches
# moderation.hash_match on); unset = photos wait for ops review.
PHOTODNA_API_KEY=
# --- Push delivery (services/worker/src/push) ---
# APNs token auth: the .p8 key's id, the Apple team id and the key contents (PEM, newlines kept or
# written as \n). All three unset = iOS pushes are recorded as failed with apns_not_configured.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PEM=
# Firebase service account JSON (one line) for FCM HTTP v1. Unset = Android pushes are recorded as
# failed with fcm_not_configured.
FCM_SERVICE_ACCOUNT_JSON=

# --- Season events research (services/worker/src/travel-data/season-research.ts) ---
# Tavily search key; with ANTHROPIC_API_KEY (the DeepSeek key) set, the monthly season.research job
# proposes dated events into the season review queue. Unset = the job is not registered.
TAVILY_API_KEY=
# Web origin the og.render job asks for share cards; unset = the link host of APP_ENV (none locally).
WEB_BASE_URL=

# --- Trip setup calendar sync (services/worker/src/jobs/calendar) ---
# The same field encryption keys as the api (OAuth tokens are sealed with them) and the same
# calendar OAuth clients, for refreshing access tokens. Unset keys = OAuth calendars do not sync.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# --- Bookings (services/worker/src/jobs/bookings, jobs/flights) ---
# R2 bucket the inbound-mail Worker writes raw messages to (reuses the R2 credentials); unset = forwarded mail is not read.
INBOUND_MAIL_BUCKET=
# Flight status providers; with neither set, cards show scheduled times and travellers report landing themselves.
AEROAPI_KEY=
AERODATABOX_KEY=
# The same mailbox scan OAuth clients as the api, for refreshing tokens.
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
MICROSOFT_MAILBOX_CLIENT_ID=
MICROSOFT_MAILBOX_CLIENT_SECRET=
# --- Billing jobs (services/worker/src/jobs/billing) ---
# The api over the private network (Railway: http://api.railway.internal:8787) and the secret its
# internal billing door expects (same value as the api's BILLING_INTERNAL_SECRET). Both unset = the
# billing queues hold their jobs until they are set.
API_INTERNAL_URL=http://localhost:8787
BILLING_INTERNAL_SECRET=

# Phrase card audio in the guide's voice (ElevenLabs Flash, v3 for languages Flash lacks). Both
# unset = custom phrase cards are written but read with the app's on-device speech. Audio is stored
# in the R2 media bucket above.
ELEVENLABS_API_KEY=
# Voice for guides whose persona names none.
ELEVENLABS_VOICE_ID=
# --- Suppliers (services/worker/src/jobs/suppliers) ---
# Travelpayouts token: nightly fare calendars and the daily affiliate conversions import; unset =
# both are off.
TRAVELPAYOUTS_TOKEN=
# Shared with the api (same value): the Viator status poll calls its settle door at API_INTERNAL_URL.
SUPPLIERS_INTERNAL_SECRET=
