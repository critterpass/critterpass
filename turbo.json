{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": [
    "CI",
    "DOCKER_HOST",
    "TESTCONTAINERS_HOST_OVERRIDE",
    "TESTCONTAINERS_RYUK_DISABLED",
    "ANDROID_HOME",
    "JAVA_HOME",
    "EXPO_TOKEN",
    "GITHUB_ACTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["APP_VARIANT", "COMMIT_SHA", "PUBLIC_*"],
      "outputs": ["dist/**", "!dist/.cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/lint/**",
        "$TURBO_ROOT$/packages/design-tokens/eslint/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/design/**", "$TURBO_ROOT$/infra/**"]
    },
    "test:db": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@cp/scripts#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
