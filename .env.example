# Local development defaults. Copy to .env (git-ignored) and fill the keys you have.
# api and worker load this file in `pnpm dev`; service-specific lists live in services/*/.env.example.

# --- local infra (pnpm infra:up) ---
DATABASE_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
DATABASE_DIRECT_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
REDIS_URL=redis://localhost:63790
PUBLIC_BASE_URL=http://localhost:8787
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=local-centrifugo-api-key
POWERSYNC_URL=http://localhost:8080
# Admin API token of the compose PowerSync container (packages/db/test/smoke/powersync-health.ts).
PS_ADMIN_API_TOKEN=local-powersync-admin-token
# The PowerSync service itself reads PS_ROLE, PS_DATA_SOURCE_URI, PS_DATA_SOURCE_SSLMODE, PS_STORAGE_URI,
# PS_STORAGE_SSLMODE, PS_PORT and PS_JWKS_URI (set by docker compose locally, Railway variables in the
# cloud; infra/powersync/README.md). PS_DATA_SOURCE_URI is always a direct Postgres connection
# (PlanetScale :5432), never PgBouncer (:6432): logical replication cannot run through a pooler.
LOG_LEVEL=debug

# --- auth (services/api; local values only — generate real secrets per environment) ---
AUTH_DATABASE_URL=postgres://app_owner:app_owner@localhost:54320/critterpass
# Any 32+ character string works locally; shared environments use `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-development-only-auth-secret-not-for-staging

# --- third-party keys (each integrating phase documents its own variables) ---
ANTHROPIC_API_KEY=
# Local-dev override: an Anthropic-compatible endpoint. Leave empty to use Anthropic's API.
ANTHROPIC_BASE_URL=
# Langfuse traces for AI calls (redacted); leave empty to send spans to OTel only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_AUTH_TOKEN=
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=
FOURSQUARE_API_KEY=
APPLE_TEAM_ID=
TILES_BASE_URL=https://pub-0cf3d04afb394624afbe8f117d1f198b.r2.dev
