{
  "client": {
    "token": { "audience": "rt" }
  },
  "channel": {
    "proxy": {
      "subscribe": { "timeout": "2s" }
    },
    "namespaces": [
      {
        "name": "crew",
        "subscribe_proxy_enabled": true,
        "presence": true,
        "allow_presence_for_subscriber": true,
        "history_size": 50,
        "history_ttl": "300s",
        "force_positioning": true,
        "force_recovery": true
      }
    ]
  },
  "engine": { "type": "redis" },
  "health": { "enabled": true },
  "admin": { "enabled": false }
}
