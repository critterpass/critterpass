  },
  "$rangeNotes": {
    "mrz": "ICAO 9303 A-Z 0-9 '<' is already covered by the 'latin' range for every Latin family; no extra codepoints needed.",
    "currency": "S$, US$ and Rp are plain Latin letters + digits (already in 'latin'); ¥ and £ come from 'latin1Supplement'; ₫ (dong) is in 'vietnamese'; ₩ (won), € (euro) and ฿ (baht sign) are 'currencyExtra'."
  },
