  "tips": [
    {
      "created_at": "2024-10-07T11:01:21.000Z",
      "text": "Another iconic place in Kyoto that gets crowded with tourists coming to take their photos. The big red torii gates are impressive though."
    },
    {
      "created_at": "2024-09-22T13:13:30.000Z",
      "text": "Insane. It is so beautiful and walking in between of the shrines is amazing."
    },
    {
      "created_at": "2024-07-28T02:22:44.000Z",
      "text": "No people! Go through the large gates, and to the smaller gates. Go straight right to the washroom, go past it and follow trail into secret bamboo grove."
    },
    {
      "created_at": "2024-02-27T16:42:02.000Z",
      "text": "It takes about 1 hour to arrive at the top of the mountain"
    },
    {
      "created_at": "2024-02-22T15:33:56.000Z",
      "text": "Food stalls at the entrance were too commercialize, nothing great. But you can get the amulet souvenir from the gift shop"
    }
  ],
  "website": "http://inari.jp"
