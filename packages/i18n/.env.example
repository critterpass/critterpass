# Tolgee translation platform (tools/scripts/i18n/tolgee-push.ts, tolgee-pull.ts). Unset in local
# dev and until the founder creates a Tolgee project — both scripts detect a missing key/project id
# and report what they would have sent/received instead of making a request.
TOLGEE_API_KEY=
TOLGEE_PROJECT_ID=
# Self-hosted Tolgee only; defaults to https://app.tolgee.io when unset.
TOLGEE_API_URL=
