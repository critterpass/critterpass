msgid "trip.lockScreen.thisTrip"
msgstr "This trip"

#: ../../apps/mobile/src/features/trip/live-activities/lock-screen-offer/offer-copy.ts
msgid "trip.lockScreen.unavailable.offline"
msgstr "You're offline, so this couldn't reach the crew's phones. Try again when you're back."
