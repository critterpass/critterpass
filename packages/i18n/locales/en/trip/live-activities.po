msgid "trip.lockScreen.unavailable.failed"
msgstr "That didn't go through. Try again in a moment."

#: ../../apps/mobile/src/features/trip/live-activities/lock-screen-offer/offer-copy.ts
msgid "trip.lockScreen.unavailable.switchedOff"
msgstr "The crew lock screen is switched off for now. The crew map still works."

#: ../../apps/mobile/src/features/trip/live-activities/lock-screen-offer/offer-copy.ts
msgid "trip.lockScreen.noMeetup.line"
msgstr "The lock screen follows a meet-up. Set one on the crew map and it goes to every phone half an hour before."

