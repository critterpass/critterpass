{
  "name": "@cp/critter-art",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Critter renderer core, drawing backends and critter data",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./canvas2d": "./src/backends/canvas2d/index.ts",
    "./skia": "./src/backends/skia/index.ts",
    "./share": "./src/share/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p gallery && tsc --noEmit -p src/web",
    "test": "vitest run --passWithNoTests",
    "test:skia": "vitest run src/backends/skia --passWithNoTests",
    "import-data": "tsx scripts/import-design-data.ts",
    "golden": "tsx golden/run-golden.ts",
    "golden:setup": "playwright install chromium",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "2.11.2"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cp/design-tokens": "workspace:*",
    "@napi-rs/canvas": "catalog:",
    "@shopify/react-native-skia": "2.11.2",
    "canvaskit-wasm": "0.41.0",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:"
  }
}
