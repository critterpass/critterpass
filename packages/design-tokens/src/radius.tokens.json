    "md": { "$type": "dimension", "$value": 14 },
    "lg": { "$type": "dimension", "$value": 20, "$description": "Cards" },
    "xl": { "$type": "dimension", "$value": 24 },
    "cardBig": { "$type": "dimension", "$value": 22 },
    "sheetTop": { "$type": "dimension", "$value": 32, "$description": "Top corners of a sheet" },
