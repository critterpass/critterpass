      },
      "mine": {
        "$type": "cpCornerSet",
        "$value": [18, 18, 4, 18],
        "$description": "theirs mirrored horizontally: top-left, top-right, bottom-right, bottom-left"
      }
    },
    "ticketStub": {
      "$type": "cpCornerSet",
