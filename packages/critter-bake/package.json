{
  "name": "@cp/critter-bake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node bake CLI producing critter assets for native, web and OG",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "bake": "tsx src/cli.ts",
    "bake:web": "tsx scripts/bake-web-webp.ts",
    "bake:og-atlas": "tsx scripts/bake-og-atlas.ts",
    "generate:mobile-assets": "tsx scripts/generate-mobile-assets.ts",
    "generate:app-icons": "tsx scripts/generate-app-icons.ts"
  },
  "dependencies": {
    "@cp/critter-art": "workspace:*",
    "@cp/design-tokens": "workspace:*",
    "@napi-rs/canvas": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "playwright": "catalog:"
  }
}
