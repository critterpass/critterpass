{
  "name": "@cp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, SQL migrations, roles/RLS, publication, withUser/withSystem",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/helpers/containers.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx seed/index.ts",
    "seed:destination": "tsx seed/destination.ts",
    "seed:cost-indices": "tsx seed/cost-indices/load.ts"
  },
  "dependencies": {
    "@cp/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@powersync/service-sync-rules": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/redis": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:"
  }
}
