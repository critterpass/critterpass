{
  "client": {
    "token": {
      "jwks_public_endpoint": "http://host.docker.internal:8787/api/auth/jwks",
      "audience": "rt"
    },
    "allowed_origins": ["http://localhost:8081", "http://localhost:4321", "http://localhost:5173"]
  },
  "channel": {
    "proxy": {
      "subscribe": {
        "endpoint": "http://host.docker.internal:8787/internal/rt/subscribe",
        "timeout": "1s"
      },
      "publish": {
        "endpoint": "http://host.docker.internal:8787/internal/rt/publish",
        "timeout": "1s"
      }
    },
    "namespaces": []
  },
  "http_api": {
    "key": "local-centrifugo-api-key"
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://redis:6379"
    }
  },
  "health": {
    "enabled": true
  },
  "admin": {
    "enabled": false
  }
}
