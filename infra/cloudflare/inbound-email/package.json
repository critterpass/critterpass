{
  "name": "@cp/inbound-email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Email Worker for crew forward addresses: stores raw mail in R2 and posts signed metadata to the api",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.141.0"
  }
}
