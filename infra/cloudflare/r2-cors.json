{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://critterpass.app",
          "https://admin.critterpass.app",
          "https://staging.critterpass.app",
          "https://admin.staging.critterpass.app",
          "http://localhost:4321",
          "http://localhost:5173",
          "http://localhost:8081"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type", "content-md5", "x-amz-checksum-sha256", "x-amz-content-sha256"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
