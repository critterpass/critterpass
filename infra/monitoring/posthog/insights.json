[
  {
    "key": "acquisition-funnel",
    "name": "Acquisition: link to saved account",
    "dashboard": "growth",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "kind": "FunnelsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "link_clicked"
          },
          {
            "kind": "EventsNode",
            "event": "install_attributed"
          },
          {
            "kind": "EventsNode",
            "event": "pass_issued"
          },
          {
            "kind": "EventsNode",
            "event": "account_saved"
          }
        ],
        "funnelsFilter": {
          "funnelWindowInterval": 14,
          "funnelWindowIntervalUnit": "day",
          "funnelVizType": "steps"
        },
        "dateRange": {
          "date_from": "-30d"
        }
      }
    }
  },
  {
    "key": "invite-time-to-issue",
    "name": "Invite fast path: time to pass (p50 / p90, target 15 s)",
    "dashboard": "growth",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "pass_issued",
            "properties": [
              {
                "key": "path",
                "value": "invited",
                "operator": "exact",
                "type": "event"
              }
            ],
            "math": "median",
            "math_property": "duration_ms",
            "custom_name": "p50 ms"
          },
          {
            "kind": "EventsNode",
            "event": "pass_issued",
            "properties": [
              {
                "key": "path",
                "value": "invited",
                "operator": "exact",
                "type": "event"
              }
            ],
            "math": "p90",
            "math_property": "duration_ms",
            "custom_name": "p90 ms"
          }
        ],
        "interval": "day",
        "dateRange": {
          "date_from": "-30d"
        },
        "trendsFilter": {
          "display": "ActionsLineGraph"
        }
      }
    }
  },
