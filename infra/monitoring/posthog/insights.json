  {
    "key": "ai-cost-per-trip",
    "name": "AI cost per crew trip (USD micros)",
    "dashboard": "ai",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "llm_call",
            "math": "sum",
            "math_property": "cost_est",
            "custom_name": "cost"
          }
        ],
        "interval": "week",
        "dateRange": {
          "date_from": "-30d"
        },
        "trendsFilter": {
          "display": "ActionsTable"
        },
        "breakdownFilter": {
          "breakdown": "trip_id",
          "breakdown_type": "event",
          "breakdown_limit": 25
        }
      }
    }
  },
  {
