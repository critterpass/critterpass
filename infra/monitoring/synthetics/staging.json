{
  "environment": "staging",
  "frequencyMs": 60000,
  "timeoutMs": 10000,
  "probes": ["Singapore", "Frankfurt"],
  "checks": [
    {
      "job": "api-health",
      "target": "https://api-staging-de92.up.railway.app/health",
      "validStatusCodes": [200]
    },
    {
      "job": "sync-liveness",
      "target": "https://powersync-api-staging.up.railway.app/probes/liveness",
      "validStatusCodes": [200]
    },
    {
      "job": "rt-websocket",
      "target": "https://centrifugo-staging-652b.up.railway.app/connection/websocket",
      "validStatusCodes": [400]
    },
    {
      "job": "web-home",
      "target": "https://staging.critterpass.app/",
      "validStatusCodes": [200]
    },
    {
      "job": "media-probe",
      "target": "https://media.staging.critterpass.app",
      "signedObjectKey": "probe/health.txt",
      "validStatusCodes": [200]
    }
  ]
}
