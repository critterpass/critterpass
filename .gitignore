# OS / editor
.DS_Store

# Dependencies and build output
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo
*.log

# Generated native projects (Expo continuous native generation) and tool caches
apps/mobile/ios/
apps/mobile/android/
# with-critter-art copies generated xcassets into each extension target's own directory on every
# prebuild (`@bacons/apple-targets` links the whole directory into Xcode via a file-system-
# synchronized group) — regenerated each time, not source.
apps/mobile/targets/*/CritterArt.xcassets/
# Inline Expo modules (apps/mobile/modules/cp-*) keep committed native source next to their own
# local Gradle/Xcode build output when built in isolation (e.g. Android Studio, `./gradlew` from the
# module dir) — only the output leaks untracked without this.
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.cxx/
apps/mobile/modules/*/ios/build/
.expo/
.astro/
.wrangler/
test-results/
playwright-report/

# Environment and secrets (only .env.example is committed)
.env
.env.*
!.env.example

# Signing material and credentials (never committed)
certs/
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.keystore
*.jks

# Wrangler local secrets
.dev.vars*
