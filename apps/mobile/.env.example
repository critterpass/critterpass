# Selects the app.config.ts variant (development | staging | production).
# Defaults to development when unset. EAS build profiles set this in eas.json instead.
APP_VARIANT=development

# Service endpoints, inlined into the bundle by Metro at build time. Unset (or empty), the api
# falls back to staging and PowerSync and realtime to production. The staging EAS profile sets the staging values in eas.json; for local infra
# (`pnpm infra:up`) point them at your machine, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
# EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080
# EXPO_PUBLIC_REALTIME_URL=ws://localhost:8000/connection/websocket
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_POWERSYNC_URL=
EXPO_PUBLIC_REALTIME_URL=

# PostHog EU project key (public client key). Unset = analytics off.
EXPO_PUBLIC_POSTHOG_KEY=

# Sentry DSN (public client key). Unset = crash reporting off.
EXPO_PUBLIC_SENTRY_DSN=
