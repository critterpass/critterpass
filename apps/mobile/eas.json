{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "e2e-test": {
      "extends": "preview",
      "distribution": "internal",
      "channel": "e2e-test",
      "environment": "development",
      "withoutCredentials": true,
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "env": {
        "APP_VARIANT": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "staging": {
      "distribution": "store",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging-de92.up.railway.app",
        "EXPO_PUBLIC_POWERSYNC_URL": "https://powersync-api-staging.up.railway.app",
        "EXPO_PUBLIC_REALTIME_URL": "wss://centrifugo-staging-652b.up.railway.app/connection/websocket",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "serviceAccountKeyPath": "../../certs/google-play-submit.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6816656656"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../certs/google-play-submit.json",
        "track": "production"
      },
      "ios": {
        "ascAppId": "6816655856"
      }
    }
  }
}
