{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "customConditions": ["react-native"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "modules",
    "plugins",
    "app.config.ts",
    "jest.config.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["babel.config.js", "metro.config.js"]
}
