# Web Worker variables and secrets (Wrangler `vars` / `wrangler secret put`); for local `wrangler dev`
# put real values in apps/web/.dev.vars (git-ignored).
# Link environment for hosts that are not a known link host (local dev, previews): production|staging|development.
LINKS_ENV=staging
# Overrides the api origin link pages fetch previews from (defaults per link environment).
LINKS_API_BASE_URL=
# Secret; same value as the api's LINKS_WEB_PROXY_SECRET (lets previews see the visitor's IP/UA).
LINKS_WEB_PROXY_SECRET=
# JSON {"<android package>": ["AA:BB:…"]}: SHA-256 of each package's upload key and Play app-signing key.
ANDROID_CERT_FINGERPRINTS=

# Build-time public keys (inlined into client scripts). Unset = off.
PUBLIC_POSTHOG_KEY=
PUBLIC_SENTRY_DSN=
PUBLIC_APP_ENV=
# Secret; HMAC key for the Open Graph card cache keys in R2 (unset = cards are drawn but not cached).
OG_CACHE_SECRET=
