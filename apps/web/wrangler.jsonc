{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cp-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // Local `wrangler dev` (no --env) uses this top-level binding against a local sqlite file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cp-waitlist",
      "database_id": "d219f5f6-a0eb-4027-bbf6-55d6010a8881",
      "migrations_dir": "migrations",
    },
  ],
  // `/` shows the full site unless SITE_MODE is `coming-soon` (src/components/site/site-mode.ts).
  "vars": { "SITE_MODE": "site" },
  // Rendered Open Graph cards (src/lib/og). OG_CACHE_SECRET is a Wrangler secret per environment.
  "r2_buckets": [{ "binding": "OG_CACHE", "bucket_name": "cp-og" }],
  "env": {
    "staging": {
      "vars": { "SITE_MODE": "site", "LINKS_ENV": "staging" },
      "r2_buckets": [{ "binding": "OG_CACHE", "bucket_name": "cp-og" }],
      "routes": [
        { "pattern": "staging.critterpass.app", "custom_domain": true },
        { "pattern": "go.staging.critterpass.app", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cp-waitlist-staging",
          "database_id": "c48254d4-e3cc-4c8a-8d96-b3f606c6ddd9",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      // The coming-soon page and its waitlist stay the front door until launch.
      "vars": { "SITE_MODE": "coming-soon", "LINKS_ENV": "production" },
      "r2_buckets": [{ "binding": "OG_CACHE", "bucket_name": "cp-og" }],
      "routes": [
        { "pattern": "critterpass.app", "custom_domain": true },
        { "pattern": "www.critterpass.app", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cp-waitlist",
          "database_id": "d219f5f6-a0eb-4027-bbf6-55d6010a8881",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
