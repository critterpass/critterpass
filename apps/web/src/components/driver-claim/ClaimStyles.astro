---
// Inline styles for the claim page: the app's dark ink and cream, system fonts, no images.
---

<style is:global>
  :root { color-scheme: dark; --ink: #17142b; --raised: #241f3d; --cream: #f6eedc; --muted: #b9b2cf; --yellow: #ffd23f; --pink: #ff5fa2; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--ink); color: var(--cream); font: 16px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; }
  .brand { letter-spacing: 0.08em; }
  nav a { color: var(--muted); margin-left: 12px; text-decoration: none; font-weight: 700; }
  nav a[aria-current='page'] { color: var(--ink); background: var(--yellow); border-radius: 999px; padding: 2px 10px; }
  main { padding: 0 20px 48px; max-width: 520px; margin: 0 auto; }
  h1 { font-size: 30px; line-height: 1.05; text-transform: uppercase; letter-spacing: -0.01em; margin: 8px 0 12px; }
  h2 { font-size: 18px; text-transform: uppercase; margin: 0 0 6px; }
  label, .field { display: flex; flex-direction: column; gap: 4px; margin: 14px 0; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  label.check { flex-direction: row; align-items: center; gap: 10px; text-transform: none; letter-spacing: 0; font-size: 16px; color: var(--cream); font-weight: 400; }
  input:not([type='checkbox']) { font: inherit; font-size: 17px; text-transform: none; letter-spacing: 0; color: var(--cream); background: var(--raised); border: 1px solid #3a335c; border-radius: 12px; padding: 12px; }
  small { font-weight: 400; text-transform: none; letter-spacing: 0; }
  .field span:last-child { color: var(--cream); font-size: 17px; text-transform: none; letter-spacing: 0; font-weight: 400; }
  button { font: inherit; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 999px; border: 2px solid var(--muted); background: transparent; color: var(--cream); padding: 12px 18px; cursor: pointer; }
  button.primary { display: block; width: 100%; background: var(--cream); color: var(--ink); border-color: var(--cream); padding: 16px; margin: 16px 0 8px; }
  button.link { border: 0; color: var(--muted); text-decoration: underline; width: 100%; }
  .card { background: var(--raised); border-radius: 18px; padding: 16px; margin: 18px 0; }
  .label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .big { font-size: 22px; font-weight: 800; margin: 6px 0 0; }
  .muted { color: var(--muted); }
  .small { font-size: 13px; }
  .tags span { display: inline-block; background: #332c55; border-radius: 999px; padding: 3px 10px; margin: 0 6px 6px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; }
  .badge { display: inline-block; background: var(--yellow); color: var(--ink); border-radius: 999px; padding: 3px 12px; font-weight: 800; font-size: 12px; text-transform: uppercase; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--raised); border-radius: 16px; padding: 14px 16px; margin: 12px 0; }
  details { background: var(--raised); border-radius: 16px; padding: 14px 16px; margin: 12px 0; }
  summary { font-weight: 700; cursor: pointer; }
  .danger { border: 2px solid var(--pink); border-radius: 16px; padding: 16px; margin: 24px 0; }
  .danger a { display: block; text-align: center; color: var(--muted); margin-top: 8px; }
  .error { background: var(--pink); color: var(--ink); border-radius: 12px; padding: 10px 14px; font-weight: 700; }
</style>
