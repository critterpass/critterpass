---
import '../styles/coming-soon.css';
import { aroundSlot, formatNumber } from '../lib/coming-soon-strings';
import { GUIDES, guideForDestination } from '../lib/guides';
import { placeNameUpper } from '../lib/place-names';
import { DESTINATIONS, FIRST_WAVE_TOTAL, WAITLIST_BASE_COUNT } from '../lib/waitlist';
import { comingSoonCopy as copy } from './site/copy/coming-soon';
import { siteTranslator } from './site/i18n';

export interface Props {
  readonly locale: string;
}

const { locale } = Astro.props;
const t = await siteTranslator(locale);
const [waveBefore, waveAfter] = aroundSlot(t, copy.waveLeft, 'count');
---

<form data-cs="join-form" class="cs-ticket__body" novalidate>
  <div class="cs-field-group">
    <span class="cs-field-group__label">{t(copy.whereFirst)}</span>
    <div class="cs-chips" role="group" aria-label={t(copy.chooseDestination)} data-cs="chips">
      {
        DESTINATIONS.map((destination, index) => {
          const guide = guideForDestination(destination.key);
          const city = placeNameUpper(guide.place, locale);
          return (
            <button
              type="button"
              class="cs-chip"
              data-cs="chip"
              data-destination={destination.key}
              aria-pressed={index === 0 ? 'true' : 'false'}
              style={index === 0 ? `background:${guide.bg}` : undefined}
            >
              <cp-critter kind={destination.kind} seed={destination.seed} size="32" label={`${guide.name}, ${city}`} />
              {city}
            </button>
          );
        })
      }
    </div>
    <div class="cs-place">
      <label class="cs-place__label" for="cs-place-input">{t(copy.searchLabel)}</label>
      <div class="cs-place__slot">
        <div class="cs-place__field">
          <input
            type="text"
            id="cs-place-input"
            class="cs-place__input"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="cs-place-list"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="search"
            placeholder={t(copy.searchPlaceholder)}
            data-cs="place-input"
          />
          <ul id="cs-place-list" class="cs-place__list" role="listbox" aria-label={t(copy.searchResults)} data-cs="place-list" hidden></ul>
          <p class="cs-place__status" role="status" data-cs="place-status" hidden></p>
        </div>
        <button type="button" class="cs-chip cs-place__picked" aria-pressed="true" data-cs="place-picked" hidden>
          <cp-critter data-cs="place-picked-critter" kind="gecko" seed="41" size="32" />
          <span data-cs="place-picked-city"></span>
          <span class="cs-place__remove" aria-hidden="true">✕</span>
        </button>
      </div>
    </div>
  </div>

  <div class="cs-form-row">
    <input
      type="email"
      name="email"
      autocomplete="email"
      inputmode="email"
      required
      placeholder={t(copy.emailPlaceholder)}
      aria-label={t(copy.emailLabel)}
      class="cs-email"
      data-cs="email-input"
      aria-describedby="cs-join-note"
    />
    <button type="submit" class="cs-submit" data-cs="join-submit">{t(copy.saveSeat)}</button>
  </div>

  <div class="cs-honeypot" aria-hidden="true">
    <label for="cs-company">Company</label>
    <input type="text" id="cs-company" name="company" tabindex="-1" autocomplete="off" />
  </div>

  <span id="cs-join-note" class="cs-note" data-cs="join-note" role="status">
    {t(copy.note)}
  </span>

  <div class="cs-wave">
    <div class="cs-wave__row">
      <span>{waveBefore}<span data-cs="wave-left">{formatNumber(locale, FIRST_WAVE_TOTAL - WAITLIST_BASE_COUNT)}</span>{waveAfter}</span>
      <span><span data-cs="wave-count">{formatNumber(locale, WAITLIST_BASE_COUNT)}</span> / {formatNumber(locale, FIRST_WAVE_TOTAL)}</span>
    </div>
    <div class="cs-wave__track">
      <div class="cs-wave__fill" data-cs="wave-fill" style="width:10%"></div>
    </div>
  </div>
</form>

<template data-cs="guide-options">
  {GUIDES.map((guide) => (
    <span data-destination={guide.destinationKey} data-bg={guide.bg} data-name={guide.name} data-place={guide.place} />
  ))}
</template>
