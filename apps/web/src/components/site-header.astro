---
import '../styles/coming-soon.css';
---

<header class="cs-header">
  <div class="cs-header__inner">
    <a href="/#join" class="cs-brand">
      <img src="/favicon.svg" width="40" height="40" alt="" aria-hidden="true" />
      <span class="cs-brand__word">CRITTERPASS</span>
    </a>
    <div class="cs-header__right">
      <span class="cs-count-chip">
        <span class="cs-ping" aria-hidden="true">
          <span class="cs-ping__ring"></span>
          <span class="cs-ping__dot"></span>
        </span>
        <span data-cs="header-count">500</span> IN LINE
      </span>
      <a href="/#join" class="cs-cta" data-cs="nav-cta">JOIN THE WAITLIST</a>
    </div>
  </div>
</header>
