---
import '../styles/coming-soon.css';
import { aroundSlot } from '../lib/coming-soon-strings';
import { GUIDES } from '../lib/guides';
import { placeName } from '../lib/place-names';
import { comingSoonCopy as copy } from './site/copy/coming-soon';
import { siteTranslator } from './site/i18n';

export interface Props {
  readonly locale: string;
}

const { locale } = Astro.props;
const t = await siteTranslator(locale);
const firstGuide = GUIDES[0]!;
const [friendsBefore, friendsAfter] = aroundSlot(t, copy.friendsJoined, 'count');
---

<div class="cs-joined" data-cs="joined-panel" hidden>
  <div class="cs-joined__top">
    <span class="cs-joined__guide">
      <cp-critter data-cs="joined-guide-critter" kind="gecko" seed="41" size="96" pose="cheer" sticker="#f4efe4"></cp-critter>
    </span>
    <div class="cs-joined__spot">
      <span class="cs-joined__spot-label">{t(copy.placeInLine)}</span>
      <span class="cs-joined__spot-value">#<span data-cs="spot-value">—</span></span>
    </div>
    <span class="cs-joined__line" data-cs="joined-line">
      {t(copy.savingSeat, { name: firstGuide.name, place: placeName(firstGuide.place, locale) })}
    </span>
  </div>

  <div class="cs-referral">
    <span class="cs-referral__title">{t(copy.bringCrew)}</span>
    <p class="cs-referral__copy">
      {t(copy.referralBody)}
    </p>
    <div class="cs-referral__row">
      <span class="cs-referral__link" data-cs="referral-link">critterpass.app/w/friend</span>
      <button type="button" class="cs-copy-btn" data-cs="copy-link">{t(copy.copyLink)}</button>
    </div>
    <div class="cs-share-row">
      <a href="#" target="_blank" rel="noopener" class="cs-share-btn" data-cs="share-whatsapp">WHATSAPP</a>
      <a href="#" class="cs-share-btn" data-cs="share-messages">{t(copy.shareMessages)}</a>
      <button type="button" class="cs-share-btn" data-cs="share-instagram">INSTAGRAM</button>
    </div>
    <div class="cs-friends-row">
      <div class="cs-friends-avatars" data-cs="friends-avatars">
        <span class="cs-friend-avatar">+</span>
        <span class="cs-friend-avatar">+</span>
        <span class="cs-friend-avatar">+</span>
      </div>
      <span class="cs-friends-count">{friendsBefore}<span data-cs="friends-count">0</span>{friendsAfter}</span>
      <button type="button" class="cs-reset-btn" data-cs="reset-email">{t(copy.differentEmail)}</button>
    </div>
  </div>
</div>
