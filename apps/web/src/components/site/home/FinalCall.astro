---
import { homeCopy as copy } from '../copy/home';
import { siteTranslator } from '../i18n';
import { SITE_PATHS } from '../site-config';
import StoreBadges from '../StoreBadges.astro';
import Sticker from '../Sticker.astro';

const t = await siteTranslator();
---

<section id="get-the-app" class="home-final site-halftone" aria-labelledby="home-final-title">
  <div class="site-wrap">
    <div class="home-ticket">
      <div class="home-ticket__main">
        <div class="home-ticket__head">
          <span class="site-eyebrow">{t(copy.finalEyebrow)}</span>
          <span class="site-eyebrow">{t(copy.finalAdmit)}</span>
        </div>
        <h2 id="home-final-title" class="site-display home-ticket__title">{t(copy.finalTitle)}</h2>
        <p class="home-ticket__body">{t(copy.finalBody)}</p>
        <div class="home-ticket__actions">
          <StoreBadges size="lg" />
          <a class="home-ticket__code" href={SITE_PATHS.joinWithCode} data-cs="final-cta">
            {t(copy.finalCode)} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="home-ticket__stub">
        <Sticker kind="alpaca" size={150} />
        <span class="site-mono">{t(copy.finalGate)}</span>
      </div>
    </div>
  </div>
</section>
