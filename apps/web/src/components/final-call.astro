---
import '../styles/coming-soon-sections.css';
---

<section class="cs-final" aria-label="Final call">
  <div class="cs-final__outer">
    <div class="cs-final__card">
      <div class="cs-final__left">
        <div class="cs-final__eyebrow-row">
          <span>FINAL CALL</span>
          <span>FIRST WAVE · 5,000 SEATS</span>
        </div>
        <h2 class="cs-final__title">The first wave boards soon</h2>
        <div class="cs-final__gate-row">
          <span class="cs-final__gate-badge" data-cs="final-gate">BOARDING SOON</span>
          <span class="cs-final__seats"><span data-cs="final-wave-left">4,500</span> first-wave seats left</span>
        </div>
        <div class="cs-final__actions">
          <a href="#join" class="cs-cta cs-final__cta" data-cs="final-cta">SAVE MY SEAT ↑</a>
          <span class="cs-final__quip">takes 10 seconds</span>
        </div>
      </div>
      <div class="cs-final__right">
        <span class="cs-final__right-critter">
          <cp-critter kind="gecko" seed="41" size="160" pose="cheer" sticker="#f4efe4" label="Tokek cheering" />
        </span>
        <span class="cs-final__gate-label">GATE ✦ ANYWHERE</span>
      </div>
    </div>
  </div>
</section>
