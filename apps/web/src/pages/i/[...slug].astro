---
import JoinLanding from '../../components/previews/JoinLanding.astro';
import LinkLanding from '../../components/previews/LinkLanding.astro';
import { loadHandoff } from '../../lib/links/load-handoff';

// Invite landing (docs/api-contracts.md §5.6): opens the app when installed, else the store. Without
// a code, the join-with-a-code page.
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');
const loaded = Astro.params.slug === undefined ? null : await loadHandoff(Astro.request, Astro.url);
if (loaded?.kind === 'redirect') return Astro.redirect(loaded.location, 302);
if (loaded !== null) Astro.response.status = loaded.status;
---

{loaded === null ? <JoinLanding /> : loaded.kind === 'page' && <LinkLanding loaded={loaded} />}
