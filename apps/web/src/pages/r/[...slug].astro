---
import LinkLanding from '../../components/previews/LinkLanding.astro';
import ReferralLanding from '../../components/previews/ReferralLanding.astro';
import { inviteCopy } from '../../components/site/copy/invite';
import { siteTranslator } from '../../components/site/i18n';
import { STORE_LINKS } from '../../components/site/site-config';
import { loadHandoff } from '../../lib/links/load-handoff';

// Referral landing (docs/api-contracts.md §5.6); `/r` itself is the "Bring your crew" page.
export const prerender = false;

const t = await siteTranslator();
const loaded = Astro.params.slug === undefined ? null : await loadHandoff(Astro.request, Astro.url);
if (loaded?.kind === 'redirect') return Astro.redirect(loaded.location, 302);
if (loaded !== null) {
  Astro.response.status = loaded.status;
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
---

{
  loaded === null ? (
    <ReferralLanding
      model={null}
      title={t(inviteCopy.referralPageTitle)}
      description={t(inviteCopy.referralBody)}
      cta={t(inviteCopy.getTheApp)}
      appStoreHref={STORE_LINKS.appStore}
      playStoreHref={STORE_LINKS.googlePlay}
    />
  ) : (
    loaded.kind === 'page' && <LinkLanding loaded={loaded} />
  )
}
