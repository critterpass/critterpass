---
/**
 * Not found. The full site answers with its own page; while the site is the coming-soon page
 * (a coming-soon build, where this page renders on demand) the answer is a plain coming-soon one
 * in the visitor's language, with no links into pages that are not there yet.
 */
import ComingSoonNotFound from '../components/coming-soon-not-found.astro';
import SiteNotFound from '../components/site/NotFound.astro';
import { resolveRequestLocale } from '../lib/locale-request';

const locale = __COMING_SOON_BUILD__ ? resolveRequestLocale(Astro).locale : null;
---

{locale === null ? <SiteNotFound /> : <ComingSoonNotFound locale={locale} />}
