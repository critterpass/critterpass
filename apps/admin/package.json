{
  "name": "@cp/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ops console SPA (Vite + React) served by the admin Worker at admin.critterpass.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/scan-bundle.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:local": "tsx scripts/seed-local.ts",
    "e2e": "playwright test",
    "deploy": "wrangler deploy -c ../../infra/cloudflare/admin/wrangler.toml",
    "admin:cmd": "tsx scripts/cmd.ts"
  },
  "dependencies": {
    "@cp/critter-art": "workspace:*",
    "@cp/design-tokens": "workspace:*",
    "@cp/domain": "workspace:*",
    "@sentry/browser": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cp/content": "workspace:*",
    "@playwright/test": "catalog:",
    "@sentry/core": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "pg": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.141.0"
  }
}
